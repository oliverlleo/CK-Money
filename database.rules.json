{
  "rules": {
    "despesas": {
      ".indexOn": ["userId"],
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pessoas": {
      ".indexOn": ["userId"],
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    }
  }
}
